{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wave",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".gitignore",
      "wrangler.jsonc",
      "CNAME",
      "robots.txt",
      "node_modules/**",
      ".wrangler/**"
    ]
  },
  "workers_dev": true,
  "preview_urls": false
}
